{
  "name": "webbox",
  "version": "0.1.0",
  "description": "Lanzador de servidores web locales para Windows",
  "private": true,
  "main": "src/main.js",
  "author": "",
  "scripts": {
    "start": "electron .",
    "demo": "electron . examples/node/app.app.json",
    "demo:static": "electron . examples/static/app.app.json",
    "package:static": "node scripts/package-static.js",
    "package:singladura": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-singladura.ps1",
    "test": "node --test test/*.test.js",
    "test:smoke": "node scripts/run-smoke.js",
    "test:packaged": "electron test/packaged-smoke.js",
    "test:portable": "node scripts/test-portable.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ajv": "8.20.0"
  }
}
